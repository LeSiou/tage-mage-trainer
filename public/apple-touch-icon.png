<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0071E3" />
      <stop offset="100%" stop-color="#0051A8" />
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.2" />
    </filter>
  </defs>

  <!-- Rounded App Icon Background -->
  <rect x="0" y="0" width="512" height="512" rx="112" ry="112" fill="url(#bgGrad)" />

  <!-- Badge Emblem -->
  <g transform="translate(256, 230)" filter="url(#shadow)">
    <!-- Graduation Cap / Target Crest -->
    <path d="M-120,-40 L0,-100 L120,-40 L0,20 Z" fill="#FFFFFF" opacity="0.95" />
    <path d="M-90,-10 L-90,50 C-90,90 90,90 90,50 L90,-10 L0,30 Z" fill="#FFFFFF" opacity="0.85" />
    <circle cx="105" cy="-20" r="14" fill="#FFCC00" />
    <path d="M105,-20 L105,70" stroke="#FFCC00" stroke-width="8" stroke-linecap="round" />
  </g>

  <!-- Typography Text -->
  <text x="256" y="420" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', sans-serif" font-weight="900" font-size="64" fill="#FFFFFF" text-anchor="middle" letter-spacing="4">TAGE MAGE</text>
</svg>